{
  "name": "@claimdesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:worker": "cross-env ROLE=worker tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "start:worker": "cross-env ROLE=worker node dist/main.js",
    "migrate": "cross-env ROLE=migrate tsx src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@claimdesk/contracts": "workspace:*",
    "@claimdesk/domain": "workspace:*",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "mongoose": "^9.9.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "ulid": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@claimdesk/config-eslint": "workspace:*",
    "@claimdesk/config-ts": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "pino-pretty": "^13.1.3",
    "rimraf": "catalog:",
    "supertest": "^7.2.2",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
