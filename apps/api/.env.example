# See the repo-root .env.example for the annotated master list.
NODE_ENV=development
ROLE=api
PORT=4000
OPS_PORT=9464
LOG_LEVEL=debug
SERVICE_NAME=claimdesk-api
ENVIRONMENT=local

# Leave empty to boot without a database (health reports mongo: "skipped").
MONGODB_URI=
MONGODB_DB_NAME=claimdesk

JWT_ACCESS_SECRET=dev-only-change-me-at-least-32-characters
JWT_REFRESH_SECRET=dev-only-change-me-at-least-32-characters

OTP_ADAPTER=dummy
OTP_DUMMY_CODE=000000

PARTNER_APPROVAL_THRESHOLD_PAISE=2500000
