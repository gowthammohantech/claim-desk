# ─── runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
ROLE=api                       # api | worker | migrate
PORT=4000
OPS_PORT=9464                  # /live, /ready, /metrics — NOT exposed via Front Door
LOG_LEVEL=debug
SERVICE_NAME=claimdesk-api
ENVIRONMENT=local

# ─── data ───────────────────────────────────────────────────────────────────
# Leave MONGODB_URI empty to boot the skeleton with no database.
# A single-node REPLICA SET is required: design/08-workflow-spec.md commits the
# claim transition and the first approval task in one transaction.
MONGODB_URI=mongodb://localhost:27017/claimdesk?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=claimdesk

# ─── blob storage (azurite in dev) ──────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_BLOB_RECEIPTS_CONTAINER=receipts
BLOB_SAS_TTL_SECONDS=300
RECEIPT_MAX_BYTES=10485760
RECEIPT_ALLOWED_MIME=image/jpeg,image/png,application/pdf

# ─── auth (mobile number + OTP -> JWT; ADR-007 / gaps.md GAP-002) ───────────
JWT_ACCESS_SECRET=dev-only-change-me-at-least-32-characters
JWT_REFRESH_SECRET=dev-only-change-me-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_ADAPTER=dummy
OTP_DUMMY_CODE=000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─── worker (Mongo-backed jobs + outbox; no Redis/BullMQ per ADR-004) ───────
WORKER_JOB_POLL_MS=2000
WORKER_OUTBOX_POLL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=4

# ─── integration adapters (all dummy for now; design/11-integration-spec) ───
OCR_ADAPTER=dummy
HR_ADAPTER=manual
ENGAGEMENT_ADAPTER=manual
ACCOUNTING_ADAPTER=file-export
PUSH_ADAPTER=expo

# ─── business config ────────────────────────────────────────────────────────
DEFAULT_CURRENCY=INR
PARTNER_APPROVAL_THRESHOLD_PAISE=2500000   # Rs 25,000 (08-workflow-spec.md §3)

# ─── observability ──────────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=claimdesk-api

# ─── clients ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1
